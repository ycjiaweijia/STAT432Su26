        "\n",
        "prob_scores = pd.DataFrame(\n",
        "    {\n",
        "        \"model\": [\"Logistic regression\", \"Random forest\"],\n",
        "        \"brier_score\": [\n",
        "            brier_score_loss(y_test, logit_prob),\n",
        "            brier_score_loss(y_test, rf_prob),\n",
        "        ],\n",
        "        \"log_loss\": [\n",
