      "id": "c9dfd86c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "Lists are often used to specify columns or hyperparameter grids."
      ],
      "id": "a157aeae"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "num_features = [\"age\", \"chol\", \"thalach\"]\n",
        "k_values = [1, 3, 5, 10]"
