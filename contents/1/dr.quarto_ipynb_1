    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| warning: false\n",
        "from sklearn.model_selection import GridSearchCV\n",
        "\n",
        "n_splits = 5\n",
        "n_train_fold = int(X_train.shape[0] * (n_splits - 1) / n_splits)\n",
