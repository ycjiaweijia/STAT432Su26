        "\n",
        "# Dimension reduction \n",
        "\n",
        "\n",
        "\n",
        "::: {.hidden}\n",
        "<!-- Constants and basic symbols -->\n",
        "\n",
        "$$\n",
        "\\require{physics}\n",
        "\\require{braket}\n",
        "$$\n",
        "\n",
        "$$\n",
        "\\newcommand{\\dl}[1]{{\\hspace{#1mu}\\mathrm d}}\n",
