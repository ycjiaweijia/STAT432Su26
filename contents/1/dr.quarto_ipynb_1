        " \\newcommand{\\pdfnormal}{{\\tt norm}}\n",
        "  \\newcommand{\\pdfexp}{{\\tt expon}}\n",
        "$$\n",
        "\n",
        "<!-- Distributions -->\n",
        "\n",
