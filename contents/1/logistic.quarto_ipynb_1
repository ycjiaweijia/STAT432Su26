      "source": [
        "#| eval: false\n",
        "import numpy as np\n",
        "from scipy.optimize import minimize\n",
        "\n",
        "\n",
        "def sigmoid(z):\n",
        "    return 1 / (1 + np.exp(-z))\n",
        "\n",
        "\n",
        "def neg_loglik(beta, X, y):\n",
        "    z = X @ beta\n",
        "    p = sigmoid(z)\n",
        "\n",
        "    # small clipping for numerical stability\n",
        "    eps = 1e-12\n",
        "    p = np.clip(p, eps, 1 - eps)\n",
        "\n",
        "    return -np.sum(y * np.log(p) + (1 - y) * np.log(1 - p))\n",
        "\n",
        "\n",
        "# Example usage:\n",
        "# X should already include a constant column\n",
        "# beta0 = np.zeros(X.shape[1])\n",
        "# out = minimize(neg_loglik, beta0, args=(X, y), method=\"BFGS\")\n",
        "# out.x"
