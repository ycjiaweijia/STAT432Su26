        "\n",
        "X = sm.add_constant(heart[[\"age\"]])\n",
        "y = heart[\"Y\"]\n",
        "\n",
        "model = sm.GLM(y, X, family=sm.families.Binomial())\n",
        "result = model.fit()\n",
