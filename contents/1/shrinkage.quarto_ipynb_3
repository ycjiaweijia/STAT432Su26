        "levels = [1.0, 2.0, 3.2, 4.8, 6.8, 9.2, 12.0]\n",
        "\n",
        "bg = \"#efe6c9\"\n",
        "fill_colors = [\"#d6eef9\", \"#bfe0ef\", \"#a9cfdf\"]\n",
        "ellipse_color = \"#d67adf\"\n",
        "path_color = \"#2b6cb0\"\n",
        "point_color = \"#2b6cb0\"\n",
        "\n",
        "shell_scales = [1 / 3, 2 / 3, 1.0]\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Boundary samplers\n",
        "# --------------------------------------------------\n",
        "def circle_boundary(r, n=4000):\n",
        "    t = np.linspace(0, 2 * np.pi, n, endpoint=False)\n",
        "    pts = np.column_stack([r * np.cos(t), r * np.sin(t)])\n",
        "    return pts\n",
        "\n",
        "\n",
        "def diamond_boundary(t, n=4000):\n",
        "    q = n // 4\n",
        "    s = np.linspace(0, 1, q, endpoint=False)\n",
        "\n",
        "    p1 = np.column_stack([t * (1 - s), t * s])  # ( t,0) -> (0, t)\n",
        "    p2 = np.column_stack([-t * s, t * (1 - s)])  # (0, t) -> (-t,0)\n",
        "    p3 = np.column_stack([-t * (1 - s), -t * s])  # (-t,0) -> (0,-t)\n",
        "    p4 = np.column_stack([t * s, -t * (1 - s)])  # (0,-t) -> ( t,0)\n",
        "\n",
        "    return np.vstack([p1, p2, p3, p4])\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Find tangency / contact points:\n",
        "# on each shell boundary, minimize RSS\n",
        "# --------------------------------------------------\n",
        "def shell_contact_points_ridge(base_r, scales):\n",
        "    pts_all = []\n",
        "    for s in scales:\n",
        "        r = base_r * s\n",
        "        pts = circle_boundary(r, n=5000)\n",
        "        vals = rss(pts[:, 0], pts[:, 1])\n",
        "        idx = np.argmin(vals)\n",
        "        pts_all.append(pts[idx])\n",
        "    return np.array(pts_all)\n",
        "\n",
        "\n",
        "def shell_contact_points_lasso(base_t, scales):\n",
        "    pts_all = []\n",
        "    for s in scales:\n",
        "        t = base_t * s\n",
        "        pts = diamond_boundary(t, n=6000)\n",
        "        vals = rss(pts[:, 0], pts[:, 1])\n",
        "        idx = np.argmin(vals)\n",
        "        pts_all.append(pts[idx])\n",
        "    return np.array(pts_all)\n",
        "\n",
        "\n",
        "ridge_path = shell_contact_points_ridge(ridge_r, shell_scales)\n",
        "lasso_path = shell_contact_points_lasso(lasso_t, shell_scales)\n",
        "\n",
        "# outer-shell solutions\n",
        "ridge_sol = ridge_path[-1]\n",
        "lasso_sol = lasso_path[-1]\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Plot\n",
        "# --------------------------------------------------\n",
        "fig, axs = plt.subplots(1, 2, figsize=(10, 5.3), facecolor=bg)\n",
        "\n",
        "for ax in axs:\n",
        "    ax.set_facecolor(bg)\n",
        "\n",
        "# ---------- Left: Lasso ----------\n",
        "ax = axs[0]\n",
        "\n",
        "# filled diamond shells\n",
        "for scale, color in zip([1.0, 2 / 3, 1 / 3], fill_colors):\n",
        "    poly = np.array(\n",
        "        [\n",
        "            [lasso_t * scale, 0],\n",
        "            [0, lasso_t * scale],\n",
        "            [-lasso_t * scale, 0],\n",
        "            [0, -lasso_t * scale],\n",
        "        ]\n",
        "    )\n",
        "    ax.add_patch(Polygon(poly, closed=True, facecolor=color, edgecolor=\"none\"))\n",
        "\n",
        "# contour ellipses\n",
        "ax.contour(X, Y, Z, levels=levels, colors=ellipse_color, linewidths=0.8)\n",
        "\n",
        "# connect contact points across shells\n",
        "ax.plot(lasso_path[:, 0], lasso_path[:, 1], color=path_color, lw=1.2)\n",
        "ax.scatter(\n",
        "    lasso_path[:, 0], lasso_path[:, 1], color=point_color, s=18, zorder=5\n",
        ")\n",
        "\n",
        "# label final solution\n",
        "ax.text(lasso_sol[0] + 0.18, lasso_sol[1] + 0.12, r\"$\\hat{\\beta}$\", fontsize=10)\n",
        "\n",
        "ax.axhline(0, color=\"0.2\", lw=0.7)\n",
        "ax.axvline(0, color=\"0.2\", lw=0.7)\n",
        "\n",
        "# ---------- Right: Ridge ----------\n",
        "ax = axs[1]\n",
        "\n",
        "# filled circle shells\n",
        "t = np.linspace(0, 2 * np.pi, 600)\n",
        "for scale, color in zip([1.0, 2 / 3, 1 / 3], fill_colors):\n",
        "    r = ridge_r * scale\n",
        "    ax.fill(r * np.cos(t), r * np.sin(t), color=color, ec=\"none\")\n",
        "\n",
        "# contour ellipses\n",
        "ax.contour(X, Y, Z, levels=levels, colors=ellipse_color, linewidths=0.8)\n",
        "\n",
        "# connect contact points across shells\n",
        "ax.plot(ridge_path[:, 0], ridge_path[:, 1], color=path_color, lw=1.2)\n",
        "ax.scatter(\n",
        "    ridge_path[:, 0], ridge_path[:, 1], color=point_color, s=18, zorder=5\n",
        ")\n",
        "\n",
        "# label final solution\n",
        "ax.text(ridge_sol[0] + 0.18, ridge_sol[1] + 0.12, r\"$\\hat{\\beta}$\", fontsize=10)\n",
        "\n",
        "ax.axhline(0, color=\"0.2\", lw=0.7)\n",
        "ax.axvline(0, color=\"0.2\", lw=0.7)\n",
        "\n",
        "# ---------- Shared format ----------\n",
        "for ax in axs:\n",
        "    ax.set_xlim(-5.5, 7.5)\n",
        "    ax.set_ylim(-5.5, 7.5)\n",
        "    ax.set_aspect(\"equal\")\n",
        "    ax.set_xlabel(r\"$\\beta_1$\", fontsize=10)\n",
        "    ax.set_ylabel(r\"$\\beta_2$\", fontsize=10)\n",
        "    ax.tick_params(labelsize=9, colors=\"0.25\")\n",
        "    for spine in ax.spines.values():\n",
        "        spine.set_color(\"0.35\")\n",
        "        spine.set_linewidth(0.8)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
