      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "One important difference between ridge and lasso is that lasso can set some coefficients exactly to zero, while ridge typically only shrinks coefficients toward zero without eliminating them."
      ],
      "id": "d46007fa"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| code-fold: true\n",
        "ridge_coef = ridge_pipe.named_steps[\"model\"].coef_\n",
        "lasso_coef = lasso_pipe.named_steps[\"model\"].coef_\n",
        "\n",
        "print(\"Number of nonzero ridge coefficients:\", np.sum(ridge_coef != 0))\n",
        "print(\"Number of nonzero lasso coefficients:\", np.sum(lasso_coef != 0))"
