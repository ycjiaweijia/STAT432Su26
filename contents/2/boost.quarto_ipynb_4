        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "\n",
        "def make_boosting_showcase(n=3000, random_state=42):\n",
        "    rng = np.random.default_rng(random_state)\n",
        "\n",
        "    X1 = rng.uniform(-3, 3, n)\n",
        "    X2 = rng.uniform(-3, 3, n)\n",
        "    X3 = rng.normal(0, 1, n)\n",
        "    X4 = rng.normal(0, 1, n)\n",
        "    X5 = rng.normal(0, 1, n)  # mostly noise\n",
        "    X6 = rng.normal(0, 1, n)  # mostly noise\n",
        "\n",
        "    # Nonlinear decision function:\n",
        "    # - circular boundary\n",
        "    # - interaction between X1 and X2\n",
        "    # - small contribution from X3\n",
        "    score = (\n",
        "        2.0 * np.sin(2 * X1)\n",
        "        + 1.5 * np.cos(2 * X2)\n",
        "        + 1.2 * (X1 * X2 > 1).astype(float)\n",
        "        - 1.0 * (X1**2 + X2**2 > 5).astype(float)\n",
        "        + 0.5 * X3\n",
        "        + rng.normal(0, 0.8, n)\n",
        "    )\n",
        "\n",
        "    y = (score > np.median(score)).astype(int)\n",
        "\n",
        "    X = pd.DataFrame(\n",
        "        {\n",
        "            \"x1\": X1,\n",
        "            \"x2\": X2,\n",
        "            \"x3\": X3,\n",
        "            \"x4\": X4,\n",
        "            \"x5_noise\": X5,\n",
        "            \"x6_noise\": X6,\n",
        "        }\n",
        "    )\n",
        "\n",
        "    return train_test_split(\n",
        "        X, y, test_size=0.3, random_state=random_state, stratify=y\n",
        "    )\n",
        "\n",
        "\n",
        "X_train, X_test, y_train, y_test = make_boosting_showcase()"
