    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "In addition, the 10th-percentile margin is of our interesting, since we treat margin<10% as no confidence."
      ],
      "id": "4799bb4f"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "train_margin_10 = []\n",
        "test_margin_10 = []\n",
        "\n",
        "for score_train, score_test in zip(\n",
        "    ada.staged_decision_function(X_train),\n",
        "    ada.staged_decision_function(X_test),\n",
        "):\n",
        "    train_margins = y_train * score_train\n",
        "    test_margins = y_test * score_test\n",
        "\n",
        "    train_margin_10.append(np.quantile(train_margins, 0.1))\n",
        "    test_margin_10.append(np.quantile(test_margins, 0.1))"
      ],
