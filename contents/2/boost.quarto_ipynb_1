    "print(\"Best test accuracy:\", np.max(test_acc))\n",
    "print(\"Best test round:\", best_test_round)\n",
    "print(\"Final training accuracy:\", train_acc[-1])\n",
    "print(\"Final test accuracy:\", test_acc[-1])"
