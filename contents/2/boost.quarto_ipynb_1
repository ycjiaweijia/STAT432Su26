        "n = 3000\n",
        "p = 10\n",
        "X = rng.normal(size=(n, p))\n",
        "\n",
        "score = (\n",
        "    1.2 * (X[:, 0] > -0.6)\n",
        "    + 1.0 * (X[:, 0] > 0.4)\n",
        "    - 1.1 * (X[:, 1] > 0.0)\n",
        "    + 0.9 * (X[:, 2] > 0.5)\n",
        "    - 0.8 * (X[:, 3] > -0.2)\n",
