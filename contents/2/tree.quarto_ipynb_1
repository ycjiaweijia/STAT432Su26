    "nodeids = path[:, target_node].toarray().ravel().nonzero()[0]\n",
    "\n",
    "pd.DataFrame({\"x[0]\": X[nodeids, 0], \"x[1]\": X[nodeids, 1], \"y\": y[nodeids]})"
   ]
