    "# AdaBoost with decision stumps\n",
    "# ============================================================\n",
    "\n",
    "ada = AdaBoostClassifier(\n",
    "    estimator=DecisionTreeClassifier(max_depth=1),\n",
    "    n_estimators=5000,\n",
    "    learning_rate=0.05,\n",
    "    random_state=1,\n",
    ")\n",
    "\n",
    "ada.fit(X_train, y_train)\n",
    "\n",
    "# ============================================================\n",
    "# Track training/test error over boosting rounds\n",
    "# ============================================================\n",
    "\n",
    "train_errors = []\n",
    "test_errors = []\n",
    "\n",
