    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "The circle sizes are proportional to the kernel weights. Points near $x_0$ have more influence on the local average.\n",
        "\n",
        "### Bandwidth in Kernel Regression"
      ],
      "id": "02d04804"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "fig, axs = plt.subplots(1, 3, figsize=(14, 4), sharey=True)\n",
        "\n",
        "for ax, bw in zip(axs, [0.15, 0.4, 1.0]):\n",
        "    y_hat = kernel_regression_predict(X, y, X_grid, bandwidth=bw)\n",
        "\n",
        "    ax.scatter(X, y, s=25, facecolors=\"none\", edgecolors=\"black\")\n",
        "    ax.plot(X_grid, 2 * np.sin(X_grid), color=\"C0\", label=\"true function\")\n",
        "    ax.plot(X_grid, y_hat, color=\"C1\", linewidth=2, label=\"kernel fit\")\n",
        "    ax.set_title(f\"h = {bw}\")\n",
        "    ax.set_xlabel(\"x\")\n",
        "\n",
        "axs[0].set_ylabel(\"y\")\n",
