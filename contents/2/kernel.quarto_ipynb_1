      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.neighbors import KNeighborsRegressor\n",
        "\n",
        "rng = np.random.default_rng(1)\n",
        "\n",
        "x_compare = rng.uniform(0, 2 * np.pi, size=40)\n",
        "y_compare = 2 * np.sin(x_compare) + rng.normal(size=len(x_compare))\n",
        "x_compare_grid = np.linspace(0, 2 * np.pi, 500)\n",
        "\n",
        "knn_compare = KNeighborsRegressor(n_neighbors=10)\n",
        "knn_compare.fit(x_compare.reshape(-1, 1), y_compare)\n",
        "y_knn = knn_compare.predict(x_compare_grid.reshape(-1, 1))\n",
        "\n",
        "\n",
        "def kernel_regression_predict(X_train, y_train, X_new, bandwidth):\n",
        "    distances = X_new[:, None] - X_train[None, :]\n",
        "    weights = np.exp(-0.5 * (distances / bandwidth) ** 2)\n",
        "    weights = weights / weights.sum(axis=1, keepdims=True)\n",
        "    return weights @ y_train\n",
        "\n",
        "\n",
        "y_kernel = kernel_regression_predict(\n",
        "    x_compare,\n",
        "    y_compare,\n",
        "    x_compare_grid,\n",
        "    bandwidth=np.std(x_compare) * 0.25,\n",
        ")\n",
        "\n",
        "fig, axs = plt.subplots(1, 2, figsize=(12, 4), sharey=True)\n",
        "\n",
        "axs[0].scatter(x_compare, y_compare, s=35, facecolors=\"none\", edgecolors=\"black\")\n",
        "axs[0].plot(x_compare_grid, 2 * np.sin(x_compare_grid), color=\"C0\", label=\"true function\")\n",
        "axs[0].plot(x_compare_grid, y_knn, color=\"C1\", label=\"KNN\")\n",
        "axs[0].set_title(\"KNN Regression\")\n",
        "\n",
        "axs[1].scatter(x_compare, y_compare, s=35, facecolors=\"none\", edgecolors=\"black\")\n",
        "axs[1].plot(x_compare_grid, 2 * np.sin(x_compare_grid), color=\"C0\", label=\"true function\")\n",
        "axs[1].plot(x_compare_grid, y_kernel, color=\"C1\", label=\"Gaussian kernel\")\n",
        "axs[1].set_title(\"Gaussian Kernel Regression\")\n",
        "\n",
        "for ax in axs:\n",
        "    ax.set_xlabel(\"x\")\n",
        "    ax.legend()\n",
        "\n",
        "axs[0].set_ylabel(\"y\")\n",
        "plt.show()"
      ],
