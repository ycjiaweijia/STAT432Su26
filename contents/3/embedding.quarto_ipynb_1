      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.datasets import make_circles\n",
        "from sklearn.cluster import KMeans, SpectralClustering\n",
        "\n",
        "X_circles, y_circles = make_circles(\n",
        "    n_samples=600,\n",
        "    factor=0.45,\n",
        "    noise=0.05,\n",
        "    random_state=1,\n",
        ")\n",
        "\n",
        "kmeans = KMeans(n_clusters=2, n_init=20, random_state=1)\n",
        "kmeans_labels = kmeans.fit_predict(X_circles)\n",
        "\n",
        "spectral = SpectralClustering(\n",
        "    n_clusters=2,\n",
        "    affinity=\"nearest_neighbors\",\n",
        "    n_neighbors=10,\n",
        "    assign_labels=\"kmeans\",\n",
        "    random_state=1,\n",
        ")\n",
        "spectral_labels = spectral.fit_predict(X_circles)\n",
        "\n",
        "fig, axs = plt.subplots(1, 3, figsize=(13, 4), sharex=True, sharey=True)\n",
        "\n",
        "axs[0].scatter(X_circles[:, 0], X_circles[:, 1], c=y_circles, s=15)\n",
        "axs[0].set_title(\"True Structure\")\n",
        "\n",
        "axs[1].scatter(X_circles[:, 0], X_circles[:, 1], c=kmeans_labels, s=15)\n",
        "axs[1].set_title(\"K-Means\")\n",
        "\n",
        "axs[2].scatter(X_circles[:, 0], X_circles[:, 1], c=spectral_labels, s=15)\n",
        "axs[2].set_title(\"Spectral Clustering\")\n",
        "\n",
        "for ax in axs:\n",
        "    ax.set_xlabel(\"x1\")\n",
        "    ax.set_ylabel(\"x2\")\n",
        "\n",
        "plt.show()"
      ],
