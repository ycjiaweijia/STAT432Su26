      "source": [
        "#| eval: false\n",
        "from minisom import MiniSom\n",
        "from sklearn.datasets import load_iris\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "iris = load_iris(as_frame=True)\n",
        "X_iris = iris.data\n",
        "y_iris = iris.target\n",
        "\n",
        "X_scaled = StandardScaler().fit_transform(X_iris)\n",
        "\n",
        "som = MiniSom(\n",
        "    x=8,\n",
        "    y=8,\n",
        "    input_len=X_scaled.shape[1],\n",
        "    sigma=1.0,\n",
        "    learning_rate=0.5,\n",
        "    random_seed=1,\n",
        ")\n",
        "\n",
        "som.random_weights_init(X_scaled)\n",
        "som.train_random(X_scaled, num_iteration=1000)\n",
        "\n",
        "locations = np.array([som.winner(x) for x in X_scaled])\n",
        "\n",
        "plt.figure(figsize=(6, 6))\n",
        "plt.scatter(locations[:, 0], locations[:, 1], c=y_iris, edgecolor=\"k\")\n",
        "plt.xlabel(\"SOM grid x\")\n",
        "plt.ylabel(\"SOM grid y\")\n",
        "plt.title(\"Self-Organizing Map\")\n",
        "plt.show()"
